---
import BlogCard from '@/components/blog-card.astro'
import LearningCard from '@/components/learning-card.astro'
import ProjectCard from '@/components/project-card.astro'
import Link from '@/components/link.astro'
import PageHead from '@/components/page-head.astro'
import TerminalIntro from '@/components/terminal-intro.astro'
import { buttonVariants } from '@/components/ui/button'
import { SITE } from '@/consts'
import Layout from '@/layouts/layout.astro'
import { getRecentPosts } from '@/lib/data-utils'
import { getLearningWithPosts, compareByStatusThenStart } from '@/lib/learning-utils'
import { getCollection } from 'astro:content'

const blog = await getRecentPosts(SITE.featuredPostCount)
const allLearning = await getLearningWithPosts()
const allProjects = await getCollection('projects')

const courses = allLearning
  .filter(e => e.id.startsWith('courses/'))
  .sort(compareByStatusThenStart)
  .slice(0, SITE.featuredLearningPerSection)

const papers = allLearning
  .filter(e => e.id.startsWith('paper-readings/'))
  .sort(compareByStatusThenStart)
  .slice(0, SITE.featuredLearningPerSection)

const projects = allProjects
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.featuredLearningPerSection)
---

<Layout class="max-w-3xl">
  <PageHead slot="head" title="Home" />
  <div class="rounded-xl border h-28 overflow-hidden">
    <TerminalIntro
      lines={[
        "Hi, I'm Jayesh.",
        "This is my digital garden: part personal blog and part project showcase.",
        "Through this blog, I would like to share my learning journey.",
      ]}
    />
  </div>
  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">Recent posts</h2>
    <ul class="flex flex-col gap-y-4">
      {
        blog.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
    <div class="flex justify-center">
      <Link
        href="/blog"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all posts <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
  <section class="flex flex-col gap-y-6">
    <h2 class="text-2xl font-medium">Recent learning</h2>

    {projects.length > 0 && (
      <div class="flex flex-col gap-y-3">
        <h3 class="text-lg font-medium">Projects</h3>
        <ul class="flex flex-col gap-y-4">
          {projects.map(entry => <ProjectCard entry={entry} />)}
        </ul>
      </div>
    )}

    {papers.length > 0 && (
      <div class="flex flex-col gap-y-3">
        <h3 class="text-lg font-medium">Paper readings</h3>
        <ul class="flex flex-col gap-y-4">
          {papers.map(entry => <li><LearningCard entry={entry} /></li>)}
        </ul>
      </div>
    )}

    {courses.length > 0 && (
      <div class="flex flex-col gap-y-3">
        <h3 class="text-lg font-medium">Courses</h3>
        <ul class="flex flex-col gap-y-4">
          {courses.map(entry => <li><LearningCard entry={entry} /></li>)}
        </ul>
      </div>
    )}

    <div class="flex justify-center">
      <Link
        href="/learning"
        class={buttonVariants({ variant: 'ghost' }) + ' group'}
      >
        See all learning <span
          class="ml-1.5 transition-transform group-hover:translate-x-1"
          >&rarr;</span
        >
      </Link>
    </div>
  </section>
</Layout>
